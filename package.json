{
  "name": "@thanhndpo/tanizy-po-agent",
  "version": "0.2.2",
  "description": "Portable Product Owner and structured problem-analysis workflows for Antigravity, Codex, and Claude Code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tanizy-po-install": "scripts/install.mjs"
  },
  "files": [
    "core",
    "adapters",
    "scripts/install.mjs",
    "LICENSE"
  ],
  "scripts": {
    "install:agent": "node scripts/install.mjs",
    "test:installer": "node --test tests/install.test.mjs",
    "test:diagrams": "python3 -B tests/drawio.test.py",
    "test:packages": "npm run build:target-packages && node --test tests/package.test.mjs",
    "pack:check": "node scripts/check-published-package.mjs .",
    "build:target-packages": "node scripts/build-target-packages.mjs"
  },
  "keywords": [
    "agent-skills",
    "product-owner",
    "five-whys",
    "root-cause-analysis",
    "codex",
    "claude-code",
    "antigravity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThanhND-po/tanizy-po-agent.git"
  },
  "homepage": "https://github.com/ThanhND-po/tanizy-po-agent#readme",
  "author": "ThanhND-po"
}
